---
import { u } from '../utils/paths';

const currentYear = new Date().getFullYear();
---

<footer class="bg-sand/60 border-t border-border-whisper mt-20 pt-16 pb-12 text-charcoal">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
      
      <!-- Brand & Studio Statement -->
      <div class="md:col-span-2 space-y-4">
        <span class="font-serif text-2xl tracking-widest uppercase font-medium">Art by Sam</span>
        <p class="font-sans text-sm text-slate-umber max-w-md leading-relaxed">
          Original canvas paintings and thoughtful bespoke illustration celebrating everyday moments, quiet beauty, and joyful warmth. Based in India, available worldwide.
        </p>
        <p class="font-hand text-lg text-terracotta pt-2">
          "Art made with warmth, from my easel to your home."
        </p>
      </div>

      <!-- Quick Directory -->
      <div class="space-y-3">
        <h4 class="font-sans text-xs uppercase tracking-widest text-charcoal font-semibold">Explore</h4>
        <ul class="space-y-2 font-sans text-xs tracking-wider text-slate-umber">
          <li><a href={u('/paintings')} class="hover:text-terracotta transition-colors">Paintings Archive</a></li>
          <li><a href={`${u('/paintings')}?status=Available`} class="hover:text-terracotta transition-colors">Available Originals</a></li>
          <li><a href={u('/illustration')} class="hover:text-terracotta transition-colors">Commercial & Event Illustration</a></li>
          <li><a href={u('/about')} class="hover:text-terracotta transition-colors">About Samridhi</a></li>
          <li><a href={u('/contact')} class="hover:text-terracotta transition-colors">Commissions & Inquiries</a></li>
        </ul>
      </div>

      <!-- Connect & Studio Socials -->
      <div class="space-y-3">
        <h4 class="font-sans text-xs uppercase tracking-widest text-charcoal font-semibold">Connect</h4>
        <ul class="space-y-2 font-sans text-xs tracking-wider text-slate-umber">
          <li>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="hover:text-terracotta transition-colors flex items-center gap-1.5">
              <span>Instagram</span>
              <span class="text-[10px] text-terracotta">↗</span>
            </a>
          </li>
          <li>
            <a href={u('/contact')} class="hover:text-terracotta transition-colors">
              Direct Commissions
            </a>
          </li>
          <li>
            <a href="mailto:hello@artbysam.com" class="hover:text-terracotta transition-colors">
              hello@artbysam.com
            </a>
          </li>
          <li>
            <a href={u('/admin')} class="text-stone-muted hover:text-charcoal transition-colors text-[11px]">
              Artist Login (CMS)
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-border-whisper/80 flex flex-col sm:flex-row items-center justify-between gap-4 font-sans text-xs text-slate-umber">
      <p>© {currentYear} Art by Sam (Samridhi). All artwork copyright reserved.</p>
      <p class="text-stone-muted text-[11px]">Designed & built for Sam · Hosted on GitHub Pages</p>
    </div>
  </div>
</footer>
