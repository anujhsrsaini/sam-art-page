---
import { u } from '../utils/paths';

interface Props {
  painting: {
    id: string;
    title: string;
    slug: string;
    category: string;
    medium: string;
    dimensions: string;
    year: number;
    image: string;
    description?: string;
  };
}

const { painting } = Astro.props;
---

<div class="group flex flex-col transition-all duration-300">
  <!-- Artwork Image Container -->
  <a
    href={u(`/paintings/${painting.slug}`)}
    class="relative block overflow-hidden bg-canvas rounded-sm border border-border-whisper/70 p-2 sm:p-3 shadow-[0_2px_10px_rgba(0,0,0,0.02)] transition-all duration-300 group-hover:shadow-[0_8px_24px_rgba(0,0,0,0.06)] group-hover:border-border-whisper"
  >
    <div class="overflow-hidden aspect-[4/5] sm:aspect-[3/4] bg-sand/30 flex items-center justify-center">
      <img
        src={painting.image.startsWith('http') ? painting.image : u(painting.image)}
        alt={`${painting.title} by Samridhi — ${painting.medium}`}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
      />
    </div>

    <!-- Category Pill -->
    <div class="absolute top-4 left-4">
      <span class="inline-flex items-center px-2.5 py-1 text-[10px] font-sans font-medium tracking-widest uppercase bg-linen/90 text-charcoal border border-border-whisper rounded-full backdrop-blur-sm">
        {painting.category}
      </span>
    </div>
  </a>

  <!-- Metadata Details -->
  <div class="pt-4 pb-2 flex flex-col space-y-1">
    <div class="flex items-baseline justify-between gap-2">
      <h3 class="font-serif text-lg sm:text-xl font-medium text-charcoal group-hover:text-terracotta transition-colors">
        <a href={u(`/paintings/${painting.slug}`)}>
          {painting.title}
        </a>
      </h3>
      <span class="font-sans text-xs text-stone-muted">
        {painting.year}
      </span>
    </div>

    <p class="font-sans text-xs text-slate-umber tracking-wide">
      {painting.medium} · {painting.dimensions}
    </p>

    <div class="pt-2 flex items-center justify-between">
      <a
        href={u(`/paintings/${painting.slug}`)}
        class="font-sans text-xs uppercase tracking-wider text-slate-umber group-hover:text-terracotta flex items-center gap-1 transition-colors"
      >
        <span>View Artwork</span>
        <span class="text-terracotta group-hover:translate-x-0.5 transition-transform">→</span>
      </a>
      <a
        href={`${u('/contact')}?type=painting&artwork=${encodeURIComponent(painting.title)}`}
        class="font-sans text-[11px] text-terracotta hover:underline font-medium"
      >
        Inquire via Form →
      </a>
    </div>
  </div>
</div>
