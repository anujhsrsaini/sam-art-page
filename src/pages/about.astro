---
import Layout from '../layouts/Layout.astro';
import { u } from '../utils/paths';
---

<Layout
  title="About Samridhi | Art by Sam"
  description="Learn about Samridhi (Sam), an independent artist and illustrator creating original paintings and bespoke stationery inspired by everyday moments."
>
  <div class="max-w-4xl mx-auto px-6 sm:px-8 pt-12 pb-24 space-y-16">
    
    <!-- Hero Introduction -->
    <div class="space-y-6 text-center">
      <span class="font-sans text-xs uppercase tracking-[0.2em] text-terracotta font-semibold block">
        The Artist & Studio
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-medium text-charcoal leading-tight">
        Behind the Canvas: <br class="hidden sm:inline" />Meet Samridhi
      </h1>
      <p class="font-hand text-2xl text-slate-umber">
        "Creating artwork that feels like stepping into a warm, sunlit afternoon."
      </p>
    </div>

    <!-- Main Studio Portrait -->
    <div class="bg-canvas p-3 sm:p-5 rounded border border-border-whisper shadow-sm">
      <div class="overflow-hidden bg-sand/30 aspect-[4/5] sm:aspect-[3/4] flex items-center justify-center">
        <img
          src={u('/images/artist-photo.jpg')}
          alt="Samridhi Kaila — artist and illustrator"
          class="w-full h-full object-cover"
        />
      </div>
      <p class="font-sans text-xs text-stone-muted text-center pt-3 italic">
        Samridhi Kaila, Chandigarh
      </p>
    </div>

    <!-- Artist Bio -->
    <div class="prose prose-stone max-w-none space-y-6 font-sans text-slate-umber text-base leading-relaxed">
      <h2 class="font-serif text-2xl sm:text-3xl text-charcoal font-medium">
        About the Artist
      </h2>
      <p>
        Hi, I'm Samridhi Kaila, an illustrator and artist based in Chandigarh, India.
        Ever since I was a child, art has been a part of my life. What began as a childhood love for making artistic school projects, has grown into a practice of exploring colour, storytelling and the beauty of everyday moments.
      </p>
      <p>
        My work is rooted in a love for colour, storytelling, and the little details that make ordinary moments feel special. I create whimsical illustrations and paintings inspired by nostalgia, nature, everyday experiences, and the beauty of the world around me.
      </p>
      <p>
        With a background in Fine Arts, specialising in Printmaking, my practice moves between illustration, painting, and design. From thoughtfully illustrated wedding invitations and playful packaging to expressive oil paintings, I enjoy exploring different ways to bring stories to life through art.
      </p>
      <p>
        I'm especially drawn to creating work that feels personal, timeless, and full of character — whether it's a keepsake made to celebrate a special occasion or a painting that captures a fleeting feeling.
      </p>
      <p>
        Through my page, I share my creative world, one illustration and painting at a time.
      </p>
    </div>

    <!-- CTA Section -->
    <div class="p-8 sm:p-12 rounded bg-sand/60 border border-border-whisper text-center space-y-4">
      <h3 class="font-serif text-2xl sm:text-3xl text-charcoal font-medium">
        Let’s Work Together
      </h3>
      <p class="font-sans text-xs sm:text-sm text-slate-umber max-w-md mx-auto leading-relaxed">
        I am always open to painting commissions, custom invitation suites, and creative brand collaborations.
      </p>
      <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={u('/contact')}
          class="px-8 py-3.5 bg-charcoal text-linen text-xs uppercase tracking-widest font-sans font-medium rounded hover:bg-terracotta transition-colors shadow-sm"
        >
          Get in Touch with Sam
        </a>
        <a
          href={u('/paintings')}
          class="px-6 py-3.5 border border-charcoal/30 text-charcoal text-xs uppercase tracking-widest font-sans font-medium rounded hover:bg-sand transition-colors"
        >
          Browse Current Paintings
        </a>
      </div>
    </div>

  </div>
</Layout>
